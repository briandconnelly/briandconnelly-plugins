{
  "name": "orb-cloud",
  "description": "MCP server for managing Orb Cloud organizations and devices",
  "version": "0.1.0",
  "author": {
    "name": "Brian Connelly"
  },
  "repository": "https://github.com/briandconnelly/orb-cloud-mcp",
  "license": "MIT",
  "mcpServers": {
    "orb-cloud": {
      "command": "uvx",
      "args": ["orb-cloud-mcp"],
      "env": {
        "ORB_CLOUD_API_KEY": "${ORB_CLOUD_API_KEY}",
        "ORB_CLOUD_CACHE_TTL": "${ORB_CLOUD_CACHE_TTL:-300}"
      }
    }
  }
}
