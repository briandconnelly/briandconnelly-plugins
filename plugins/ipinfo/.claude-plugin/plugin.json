{
  "name": "ipinfo",
  "description": "MCP server for getting IP address details, location, and network information via ipinfo.io",
  "version": "0.5.0",
  "author": {
    "name": "Brian Connelly"
  },
  "repository": "https://github.com/briandconnelly/mcp-server-ipinfo",
  "license": "MIT",
  "keywords": ["ip", "networking", "geolocation", "mcp"],
  "mcpServers": {
    "mcp-server-ipinfo": {
      "command": "uvx",
      "args": ["mcp-server-ipinfo==0.5.0"],
      "env": {
        "IPINFO_API_TOKEN": "${IPINFO_API_TOKEN}",
        "IPINFO_CACHE_TTL": "${IPINFO_CACHE_TTL:-3600}"
      }
    }
  }
}
